{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flaggo.dev/schemas/evidence-value-v1.schema.json",
  "title": "Flaggo evidence canonical value v1",
  "description": "Lossless tagged cells. This scalar contract does not version or replace the existing query-result envelope.",
  "oneOf": [
    {
      "type": "object",
      "properties": { "kind": { "const": "null" } },
      "required": ["kind"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "int64" },
        "value": {
          "type": "string",
          "description": "Canonical decimal text from -9223372036854775808 through 9223372036854775807; no plus sign, leading zeros or negative zero.",
          "pattern": "^(?:0|-?(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)|-9223372036854775808)(?![\\s\\S])"
        }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "float64" },
        "bits": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
          "description": "The IEEE-754 binary64 bit pattern, most significant digit first. Preserves signed zero, infinities and NaN payloads without JSON numeric conversion."
        }
      },
      "required": ["kind", "bits"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "text" },
        "value": { "type": "string" }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "json" },
        "value": {
          "type": "string",
          "contentMediaType": "application/json",
          "description": "Exact JSON text, not a parsed nested JSON value. Consumers must validate its syntax; contentMediaType alone is an annotation, not an assertion. Numeric lexemes and object member order are preserved."
        }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    }
  ]
}
