{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flaggo.dev/contracts/schemas/runtime-models-v3.schema.json",
  "title": "Flaggo runtime API models v3",
  "description": "Strict wire models for stateless DecisionContract evaluation and service health. The SDK constructs the complete RuntimeInput, including internal attributes and optional current exposure.",
  "$defs": {
    "DecisionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "description": "Stable user-owned identity of a named DecisionContract resource."
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Project digest form: sha256:<lowercase-hex>."
    },
    "Rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC 3339 UTC timestamp using the Z suffix."
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "RuntimeAttributes": {
      "type": "object",
      "required": [
        "_random"
      ],
      "maxProperties": 129,
      "propertyNames": {
        "type": "string",
        "maxLength": 128
      },
      "properties": {
        "_random": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "SDK-generated internal random value, reused for retries of one logical evaluation."
        }
      },
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "additionalProperties": false,
      "description": "Complete SDK-constructed attribute map. The v3 wire profile reserves underscore-prefixed names and defines only _random. Semantic validation rejects user attributes not declared by the contract."
    },
    "CurrentExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposureId"
      ],
      "properties": {
        "exposureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "SDK-managed identity of the previous decision actually applied in the current activity context."
        }
      }
    },
    "RuntimeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributes"
      ],
      "properties": {
        "attributes": {
          "$ref": "#/$defs/RuntimeAttributes"
        },
        "currentExposure": {
          "$ref": "#/$defs/CurrentExposure"
        }
      }
    },
    "RuleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "rule"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        }
      }
    },
    "DefaultEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "const": "default"
        }
      }
    },
    "EvaluationProvenance": {
      "oneOf": [
        {
          "$ref": "#/$defs/RuleEvaluation"
        },
        {
          "$ref": "#/$defs/DefaultEvaluation"
        }
      ]
    },
    "RuntimeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractDigest",
        "executableDigest",
        "result",
        "evaluation"
      ],
      "properties": {
        "contractDigest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "executableDigest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "result": {
          "$ref": "#/$defs/JsonValue",
          "description": "Decision result. Runtime also validates it against the accepted DecisionContract result schema."
        },
        "evaluation": {
          "$ref": "#/$defs/EvaluationProvenance"
        }
      }
    },
    "LivenessResult": {
      "type": "object",
      "required": [
        "status",
        "service",
        "version",
        "observedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "live"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "$ref": "#/$defs/Rfc3339"
        }
      }
    },
    "ReadinessCheck": {
      "type": "object",
      "required": [
        "name",
        "status",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "up",
            "degraded",
            "down"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "ReadinessResult": {
      "type": "object",
      "required": [
        "status",
        "observedAt",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "degraded",
            "not-ready"
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/Rfc3339"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReadinessCheck"
          }
        }
      }
    }
  }
}
