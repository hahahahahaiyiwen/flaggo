{
  "name": "decide-unknown-definition",
  "scenario": 7,
  "invariant": "Unknown expected definition for a known key returns 409 contract-not-registered; the runtime never selects an older registered revision and forbids local fallback.",
  "requestSchema": "runtime-models-v1.schema.json#/$defs/DecideRequest",
  "responseSchema": "problem-details-v1.schema.json",
  "request": {
    "method": "POST",
    "path": "/v1/decisions/tetris.dropInterval:decide",
    "headers": {
      "Authorization": "Bearer test-access-token",
      "Content-Type": "application/json"
    },
    "body": {
      "expectedContract": {
        "definitionId": "def_UNKNOWN0000000000000000000",
        "contractDigest": "sha256:377a1df50a8538bb3642fde744fbc0f8ef8790e6b5ade74086c5f14e28a633e8",
        "revision": "rev_UNKNOWN0000000000000000000"
      },
      "runtimeTarget": {
        "type": "session",
        "id": "game-456"
      },
      "runtimeContext": {
        "sessionId": "game-456",
        "userId": "user-123",
        "cohort": "new_players",
        "deviceType": "mobile"
      },
      "inputs": {
        "boardPressure": 0.82,
        "currentLevel": 1,
        "recentPlacementTimeMs": 1200,
        "recoveryFailures": 0
      },
      "client": {
        "appId": "tetris-demo",
        "environment": "dev",
        "sdk": "typescript",
        "sdkVersion": "0.1.0"
      }
    }
  },
  "expected": {
    "status": 409,
    "headers": {
      "Content-Type": "application/problem+json",
      "X-Flaggo-Correlation-Id": "srv-contract-not-registered"
    },
    "body": {
      "type": "https://flaggo.dev/problems/contract-not-registered",
      "title": "Contract not registered",
      "status": 409,
      "code": "contract-not-registered",
      "instance": "/v1/decisions/tetris.dropInterval:decide",
      "correlationId": "srv-contract-not-registered",
      "detail": "The expected definitionId/revision is not registered."
    }
  }
}
