{
  "name": "runtime-and-management-schema-negative-cases",
  "scenario": 33,
  "invariant": "Malformed complete runtime inputs, invalid evaluation provenance, non-finite JSON numbers, and invalid DecisionContract shapes are rejected.",
  "schemaNegative": true,
  "request": {
    "method": "POST",
    "path": "/v3/decision-contracts/tetris.dropInterval/versions/sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/decisions",
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "expected": {
    "status": 0,
    "headers": {},
    "note": "Schema-negative conformance fixture; not an HTTP exchange."
  },
  "rejectedSamples": [
    {
      "why": "the complete RuntimeInput must include SDK-generated _random",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "user_id": "user-123"
        }
      }
    },
    {
      "why": "_random must be less than one",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "_random": 1
        }
      }
    },
    {
      "why": "_random must not be negative",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "_random": -0.01
        }
      }
    },
    {
      "why": "the v3 wire profile defines no internal attribute other than _random",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "_random": 0.42,
          "_bucket": 17
        }
      }
    },
    {
      "why": "current exposure requires a non-empty exposure identity",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "_random": 0.42
        },
        "currentExposure": {
          "exposureId": ""
        }
      }
    },
    {
      "why": "runtime request correlation is header-only",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeInput",
      "body": {
        "attributes": {
          "_random": 0.42
        },
        "correlationId": "body-source-is-forbidden"
      }
    },
    {
      "why": "a runtime decision must identify its executable",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision",
      "body": {
        "contractDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "result": 700,
        "evaluation": {
          "source": "default"
        }
      }
    },
    {
      "why": "rule evaluation provenance requires the matching rule name",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision",
      "body": {
        "contractDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "executableDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "result": 700,
        "evaluation": {
          "source": "rule"
        }
      }
    },
    {
      "why": "default evaluation provenance cannot claim a rule",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision",
      "body": {
        "contractDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "executableDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "result": 800,
        "evaluation": {
          "source": "default",
          "rule": "unexpected-rule"
        }
      }
    },
    {
      "why": "a deployed DecisionContract must declare the authority covered by its digest",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionContract",
      "body": {
        "name": "example.decision",
        "expression_syntax": "flaggo.cel/v1",
        "attributes": [],
        "result": {
          "schema": {
            "type": "boolean"
          },
          "default": false
        }
      }
    },
    {
      "why": "user-declared attribute names cannot use the reserved internal prefix",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionContract",
      "body": {
        "authority": {
          "tenant": "local",
          "application": "example",
          "environment": "integration"
        },
        "name": "example.decision",
        "expression_syntax": "flaggo.cel/v1",
        "attributes": [
          {
            "name": "_random",
            "schema": {
              "type": "number"
            }
          }
        ],
        "result": {
          "schema": {
            "type": "boolean"
          },
          "default": false
        }
      }
    },
    {
      "why": "an authored rule cannot contain both a natural-language condition and a deterministic expression",
      "schemaRef": "management-models-v3.schema.json#/$defs/AuthoredWhen",
      "body": {
        "condition": "The user needs recovery time.",
        "expression": "attributes.recovery_failures > 0"
      }
    },
    {
      "why": "runtime timestamp uses an offset instead of the required UTC Z suffix",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/Rfc3339",
      "body": "2026-07-30T14:30:00-04:00"
    },
    {
      "why": "the retired auto-approval policy name is invalid; the initial learning policy supports only auto-activation",
      "schemaRef": "management-models-v3.schema.json#/$defs/LearningPolicy",
      "body": {
        "mode": "auto-approval",
        "evaluate": {
          "interval": "PT15M"
        }
      }
    },
    {
      "why": "every evidence declaration requires exactly one OpenTelemetry source",
      "schemaRef": "management-models-v3.schema.json#/$defs/Evidence",
      "body": {
        "name": "processing_latency",
        "attribute": "processingLatencyMs",
        "correlateBy": []
      }
    },
    {
      "why": "the retired evidence binding is not a source",
      "schemaRef": "management-models-v3.schema.json#/$defs/Evidence",
      "body": {
        "name": "processing_latency",
        "attribute": "processingLatencyMs",
        "binding": "worker.processing_latency",
        "correlateBy": [],
        "source": {
          "kind": "log",
          "scope": "adaptive-worker.app",
          "name": "worker.processing_latency",
          "correlation": {}
        }
      }
    },
    {
      "why": "source variants cannot mix fields from different OpenTelemetry signal kinds",
      "schemaRef": "management-models-v3.schema.json#/$defs/EvidenceSource",
      "body": {
        "kind": "log",
        "scope": "adaptive-worker.app",
        "name": "worker.processing_latency",
        "metricKind": "gauge",
        "unit": "ms",
        "correlation": {}
      }
    },
    {
      "why": "a valid contract validation result requires the computed contract digest",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionContractValidationResult",
      "body": {
        "status": "valid",
        "issues": []
      }
    },
    {
      "why": "an invalid contract validation result requires a non-empty error issue",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionContractValidationResult",
      "body": {
        "status": "invalid",
        "issues": [
          {
            "code": "informational-warning",
            "severity": "warning",
            "path": "/result",
            "message": "Warning only."
          }
        ]
      }
    },
    {
      "why": "a valid contract validation result cannot contain an error issue",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionContractValidationResult",
      "body": {
        "status": "valid",
        "contractDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "issues": [
          {
            "code": "contradictory-error",
            "severity": "error",
            "path": "/result",
            "message": "A valid result cannot contain this error."
          }
        ]
      }
    },
    {
      "why": "a generated DecisionExecutable cannot contain a natural-language condition",
      "schemaRef": "management-models-v3.schema.json#/$defs/DecisionExecutable",
      "body": {
        "contractDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "kind": "rules",
        "rules": [
          {
            "name": "recovery",
            "when": {
              "condition": "A recent recovery attempt failed."
            },
            "return": {
              "value": 700
            }
          }
        ]
      }
    }
  ],
  "rejectedFixtureMutations": [
    {
      "why": "rule provenance cannot be relabeled as default while retaining a rule",
      "fixture": "runtime/decisions/01-rule-result.json",
      "path": "/evaluation/source",
      "value": "default",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision"
    },
    {
      "why": "default provenance cannot gain a rule field",
      "fixture": "runtime/decisions/02-default-result.json",
      "path": "/evaluation/rule",
      "value": "unexpected-rule",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision"
    },
    {
      "why": "executable digests use the canonical sha256 form",
      "fixture": "runtime/decisions/01-rule-result.json",
      "path": "/executableDigest",
      "value": "not-a-digest",
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision"
    }
  ],
  "acceptedFixtureMutations": [
    {
      "why": "A runtime result may be any JSON value before semantic validation against the contract result schema.",
      "fixture": "runtime/decisions/02-default-result.json",
      "path": "/result",
      "value": {
        "mode": "safe",
        "limits": [
          1,
          2,
          3
        ]
      },
      "schemaRef": "runtime-models-v3.schema.json#/$defs/RuntimeDecision"
    }
  ],
  "rejectedJsonDocuments": [
    "{\"value\":NaN}",
    "{\"value\":Infinity}",
    "{\"value\":-Infinity}"
  ]
}
