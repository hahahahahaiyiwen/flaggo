  "responseSchema": "problem-details-v3.schema.json",
  "request": {
    "method": "POST",
    "path": "/v3/decision-contracts/tetris.dropInterval/versions/sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/decisions",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "attributes": {
        "_random": 0.42,
        "user_id": "user-123"
      }
    }
  },
  "expected": {
    "status": 429,
    "headers": {
