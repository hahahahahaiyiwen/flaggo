{
  "name": "validate-bundle-invalid",
  "scenario": 15,
  "invariant": "A well-formed but invalid bundle returns 200 status invalid with structured issues and no mutation.",
  "requestSchema": "decision-definition-bundle-v2.schema.json",
  "responseSchema": "management-models-v1.schema.json#/$defs/DefinitionBundleValidationResult",
  "request": {
    "method": "POST",
    "path": "/v1/definition-bundles:validate",
    "headers": {
      "Authorization": "Bearer test-access-token",
      "Content-Type": "application/json"
    },
    "body": {
      "application": {
        "id": "tetris-demo",
        "environment": "dev"
      },
      "build": {
        "buildId": "tetris-web-2026-07-25.1",
        "artifactDigest": "sha256:aa11bb22cc33dd44ee55ff6677889900aabbccddeeff00112233445566778899",
        "version": "0.1.0"
      },
      "source": {
        "repository": "github.com/flaggo/tetris-demo",
        "path": "src/flaggo",
        "commit": "a1b2c3d4"
      },
      "format": "flaggo.decision-definition-bundle/v2",
      "decisions": {
        "tetris.dropInterval": {
          "result": {
            "type": "number",
            "min": 200,
            "max": 1500,
            "step": 50,
            "default": 800
          },
          "context": {
            "userId": {
              "type": "string",
              "target": "user"
            },
            "sessionId": {
              "type": "string",
              "target": "session"
            },
            "cohort": {
              "type": "string",
              "target": "cohort"
            },
            "deviceType": {
              "type": "string"
            }
          },
          "targeting": {
            "hierarchy": [
              "session",
              "user",
              "cohort",
              "global"
            ],
            "primary": "session",
            "fallbackOrder": [
              "cohort",
              "global"
            ]
          },
          "inputs": {
            "boardPressure": {
              "source": "evidence",
              "binding": "missingBinding"
            },
            "currentLevel": {
              "source": "request",
              "type": "number",
              "meaning": "Current game level.",
              "range": [
                0,
                20
              ]
            },
            "recentPlacementTimeMs": {
              "source": "request",
              "type": "number",
              "meaning": "Application's current placement-time estimate.",
              "unit": "ms",
              "range": [
                0,
                2000
              ]
            },
            "recoveryFailures": {
              "source": "request",
              "type": "number",
              "meaning": "Current recovery-failure count supplied by the game.",
              "range": [
                0,
                5
              ]
            }
          },
          "evidence": {},
          "policy": {
            "kind": "inline",
            "constraints": [
              {
                "kind": "cooldown",
                "seconds": 20
              },
              {
                "kind": "max-delta",
                "value": 50
              },
              {
                "kind": "number-bounds",
                "min": 200,
                "max": 1500
              }
            ]
          },
          "intent": {
            "type": "natural-language",
            "text": "Keep gameplay challenging but playable while reducing early frustration."
          }
        }
      }
    }
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "X-Flaggo-Correlation-Id": "srv-validate-invalid"
    },
    "body": {
      "status": "invalid",
      "issues": [
        {
          "code": "invalid-definition",
          "severity": "error",
          "path": "/decisions/tetris.dropInterval/inputs/boardPressure",
          "message": "Unknown evidence binding.",
          "decisionKey": "tetris.dropInterval",
          "inputKey": "boardPressure"
        }
      ]
    }
  }
