{
  "name": "validate-decision-contract-valid",
  "scenario": 44,
  "invariant": "Validation computes the exact contract digest without mutating accepted state.",
  "requestSchema": "management-models-v3.schema.json#/$defs/DecisionContract",
  "responseSchema": "management-models-v3.schema.json#/$defs/DecisionContractValidationResult",
  "request": {
    "method": "POST",
    "path": "/v3/decision-contracts/tetris.dropInterval/validate",
    "headers": {
      "Authorization": "******",
      "Content-Type": "application/json"
    },
    "body": {
      "name": "tetris.dropInterval",
      "expression_syntax": "flaggo.cel/v1",
      "attributes": [
        {
          "name": "board_pressure",
          "schema": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "name": "current_level",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "recent_placement_time_ms",
          "schema": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "name": "recovery_failures",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "session_id",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "schema": {
          "type": "number",
          "minimum": 100,
          "maximum": 1000
        },
        "default": 500
      },
      "authoredExecutable": {
        "rules": [
          {
            "name": "high-pressure",
            "when": {
              "expression": "attributes.board_pressure >= 0.8"
            },
            "return": {
              "value": 250
            }
          },
          {
            "name": "level-adjustment",
            "when": {
              "expression": "attributes.current_level >= 10"
            },
            "return": {
              "expression": "1000.0 - double(attributes.current_level) * 25.0"
            }
          }
        ]
      },
      "learning": {
        "policy": {
          "mode": "auto-activation",
          "evaluate": {
            "interval": "PT15M"
          }
        },
        "evidence": [
          {
            "name": "placement_time",
            "attribute": "recent_placement_time_ms",
            "correlateBy": [
              "session_id"
            ],
            "source": {
              "kind": "metric",
              "scope": "tetris.engine",
              "name": "tetris.placement_time",
              "metricKind": "histogram",
              "unit": "ms",
              "correlation": {
                "session_id": {
                  "location": "signal",
                  "attribute": "tetris.session.id"
                }
              }
            }
          },
          {
            "name": "recovery_failure",
            "attribute": "recovery_failures",
            "correlateBy": [
              "session_id"
            ],
            "source": {
              "kind": "metric",
              "scope": "tetris.engine",
              "name": "tetris.recovery_failure",
              "metricKind": "sum",
              "unit": "{failure}",
              "correlation": {
                "session_id": {
                  "location": "signal",
                  "attribute": "tetris.session.id"
                }
              }
            }
          }
        ],
        "objective": {
          "primary": {
            "evidence": "placement_time",
            "direction": "minimize"
          },
          "guardrails": [
            {
              "name": "no-recovery-failures",
              "expression": "sum(evidence.recovery_failure) <= 0"
            }
          ]
        }
      }
    }
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "X-Flaggo-Correlation-Id": "srv-contract-validate-valid"
    },
    "body": {
      "status": "valid",
      "contractDigest": "sha256:3c93eda4a9f8ab8b602a08644db59d19ab1219406b26b32aff8ef2c52c4c2040",
      "issues": []
    }
  }
}
