{
  "name": "get-current-contract-catalog",
  "scenarios": [],
  "invariant": "The catalog returns only current contracts in the explicit authorized scope, without creating a snapshot identity.",
  "responseSchema": "management-models-v4.schema.json#/$defs/CurrentContractCatalog",
  "request": {
    "method": "GET",
    "path": "/v4/tenants/local/applications/tetris/environments/integration/decision-contract-catalog/current",
    "headers": {}
  },
  "expected": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "ETag": "\"catalog-7\"",
      "X-Flaggo-Correlation-Id": "srv-contract-catalog-current"
    },
    "body": {
      "contracts": [
        {
          "contractDigest": "sha256:aa59121ed2dfcf519654df1d3f9c60fa141aa4ddb199c207bd9d12b3a515714a",
          "contract": {
            "authority": {
              "tenant": "local",
              "application": "tetris",
              "environment": "integration"
            },
            "name": "tetris.dropInterval",
            "expression_syntax": "flaggo.cel/v1",
            "attributes": [],
            "result": {
              "schema": {
                "type": "number",
                "minimum": 100,
                "maximum": 1000
              },
              "default": 500
            }
          }
        }
      ]
    }
  }
}
