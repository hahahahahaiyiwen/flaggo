{
  "name": "exposure-confirm-invalid-applied-at",
  "scenario": 12,
  "invariant": "Invalid appliedAt or clock skew beyond accepted bounds returns 422 invalid-applied-at.",
  "requestSchema": "runtime-models-v1.schema.json#/$defs/ExposureConfirmationRequest",
  "responseSchema": "problem-details-v1.schema.json",
  "request": {
    "method": "POST",
    "path": "/v1/exposures/decision-123:confirm",
    "headers": {
      "Authorization": "Bearer test-access-token",
      "Content-Type": "application/json"
    },
    "body": {
      "confirmToken": "confirm-abc",
      "appliedAt": "2099-01-01T00:00:00Z"
    }
  },
  "expected": {
    "status": 422,
    "headers": {
      "Content-Type": "application/problem+json",
      "X-Flaggo-Correlation-Id": "srv-invalid-applied-at"
    },
    "body": {
      "type": "https://flaggo.dev/problems/invalid-applied-at",
      "title": "Invalid applied at",
      "status": 422,
      "code": "invalid-applied-at",
      "instance": "/v1/decisions/tetris.dropInterval:decide",
      "correlationId": "srv-invalid-applied-at",
      "detail": "appliedAt is outside accepted clock-skew bounds."
    }
  }
}
