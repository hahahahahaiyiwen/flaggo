{
  "name": "@flaggo/sdk",
  "version": "0.2.0",
  "description": "TypeScript clients for Flaggo runtime decisions and contract management.",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run generate && node scripts/build.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "check:openapi": "vitest run test/openapi-conformance.test.ts",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "generate": "node scripts/generate.mjs",
    "test": "npm run generate && vitest run",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "24.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
