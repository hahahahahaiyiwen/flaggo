{
  "name": "@flaggo/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for Flaggo AI-native runtime decisioning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "import": "./dist/management.js"
    }
  },
  "bin": {
    "flaggo-manifest": "./dist/manifest-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:openapi": "vitest run test/openapi-conformance.test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "vitest": "3.2.4",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
