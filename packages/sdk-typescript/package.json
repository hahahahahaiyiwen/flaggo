{
  "name": "@flaggo/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for Flaggo AI-native runtime decisioning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extractor": {
      "types": "./dist/extractor.d.ts",
      "import": "./dist/extractor.js"
    }
  },
  "bin": {
    "flaggo-extract": "./dist/extract-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
