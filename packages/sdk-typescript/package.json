{
  "name": "@flaggo/sdk",
  "version": "0.2.0",
  "description": "TypeScript clients and OpenTelemetry integration for Flaggo.",
  "type": "module",
  "exports": {
    "./configuration": {
      "types": "./dist/configuration/index.d.ts",
      "import": "./dist/configuration/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry/index.d.ts",
      "import": "./dist/opentelemetry/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "@opentelemetry/api-logs": ">=0.222.0 <0.223.0",
    "@opentelemetry/resources": ">=2.11.0 <2.12.0",
    "@opentelemetry/sdk-logs": ">=0.222.0 <0.223.0",
    "@opentelemetry/sdk-metrics": ">=2.11.0 <2.12.0",
    "@opentelemetry/sdk-trace": ">=2.11.0 <2.12.0"
  },
  "scripts": {
    "build": "npm run generate && node scripts/build.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "check:openapi": "vitest run test/openapi-conformance.test.ts",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "generate": "node scripts/generate.mjs",
    "test": "npm run generate && vitest run",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "24.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
