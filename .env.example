# Fixture-backed development API
FLAGGO_HOST=127.0.0.1
FLAGGO_PORT=8080

# Reserved for future server implementations. Local development must remain
# usable without cloud credentials.
FLAGGO_ENVIRONMENT=local

# Explicit local-only authentication bypass. Production must leave this false
# and configure OAuth authority/audience instead.
Flaggo__Authentication__LocalDevelopmentBypass=false
Flaggo__Authentication__Authority=https://auth.example.com/
Flaggo__Authentication__Audience=flaggo-data-plane

# Optional absolute override. When omitted, both local hosts share
# .flaggo/definition-registry-v1.json under the repository root.
# Flaggo__Registry__LocalFilePath=C:\flaggo-state\definition-registry-v1.json

# Direct state/evidence configuration points to atomically published commit
# descriptors, never raw mutable JSON. Use CommittedFileSnapshotWriter or the
# example publishJsonArtifact helper to create the immutable artifact plus its
# format/version, byteLength, and sha256 descriptor.
# Flaggo__State__LocalFilePath=C:\flaggo-state\state.commit.json
# Flaggo__Evidence__LocalFilePath=C:\flaggo-state\evidence.commit.json

# A bootstrap generation is the preferred single source of truth when receipt,
# state, and evidence must switch together. Its current.json manifest pins all
# three immutable generation artifacts by exact byte length and sha256.
# Flaggo__Bootstrap__LocalGenerationPath=C:\flaggo-state\tetris-bootstrap
