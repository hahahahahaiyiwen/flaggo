# Fixture-backed development API
FLAGGO_HOST=127.0.0.1
FLAGGO_PORT=8080

# Reserved for future server implementations. Local development must remain
# usable without cloud credentials.
FLAGGO_ENVIRONMENT=local

# Explicit local-only authentication bypass. Production must leave this false
# and configure OAuth authority/audience instead.
Flaggo__Authentication__LocalDevelopmentBypass=false
Flaggo__Authentication__Authority=https://auth.example.com/
Flaggo__Authentication__Audience=flaggo-data-plane
