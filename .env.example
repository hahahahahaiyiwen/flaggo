# Shared local configuration for Contract Service and Decision Service.
# Assign a different ASPNETCORE_URLS value to each process when launching them
# manually. The example launchers allocate ports automatically.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ConnectionStrings__Flaggo=Data Source=flaggo.db;Pooling=False

# Explicit local-only authentication bypass. It is rejected outside the
# Development environment.
Flaggo__Authentication__LocalDevelopmentBypass=true
Flaggo__Authentication__Application=local-application
Flaggo__Authentication__Environment=development

# Production uses bearer authentication instead. Replace these example values,
# set the environment to Production, and leave the local bypass disabled.
# Flaggo__Authentication__LocalDevelopmentBypass=false
# Flaggo__Authentication__Authority=https://identity.example.com/
# Flaggo__Authentication__Audience=flaggo
# Flaggo__Authentication__RequireHttpsMetadata=true
