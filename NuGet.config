<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Do not inherit authenticated workstation feeds. This endpoint mirrors public NuGet packages. -->
  <packageSources>
    <clear />
    <add
      key="public-nuget-proxy"
      value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json"
      protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <auditSources>
    <clear />
    <add
      key="public-nuget-proxy"
      value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json"
      protocolVersion="3" />
  </auditSources>
</configuration>
