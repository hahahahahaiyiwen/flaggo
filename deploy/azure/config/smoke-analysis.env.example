FLAGGO_CONTRACT_SERVICE_URL=http://127.0.0.1:8080
FLAGGO_CONTRACT_CATALOG_URL=http://127.0.0.1:8080/v3/decision-contract-catalog/current
FLAGGO_ANALYSIS_WORKSPACE_ROOT=/var/lib/flaggo/analysis-workspaces
FLAGGO_ANALYSIS_COPILOT_HOME=/var/lib/flaggo/copilot-home
FLAGGO_ANALYSIS_SKILL_DIRECTORY=/opt/flaggo/current/skills
FLAGGO_ANALYSIS_PYTHON=/opt/flaggo/current/python/bin/python3.12
FLAGGO_ANALYSIS_MAX_AGENTS=1
# Required by shared config parsing; the deterministic binary does not start
# Copilot or use a GitHub login. The live unit remains disabled.
FLAGGO_ANALYSIS_INFERENCE=github
FLAGGO_TETRIS_ANALYSIS_SCENARIO=reviewed-python-exit
FLAGGO_ANALYSIS_POLL_INTERVAL_MS=250
FLAGGO_ANALYSIS_RUN_TIMEOUT_SECONDS=120
FLAGGO_ANALYSIS_YIELD_GRACE_SECONDS=2
