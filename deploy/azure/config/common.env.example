FLAGGO_DATABASE_URL=sqlite:///var/lib/flaggo/flaggo.db
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4319
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
COPILOT_CLI_EXTRACT_DIR=/opt/flaggo/current/copilot
PYTHONHOME=/opt/flaggo/current/python
LD_LIBRARY_PATH=/opt/flaggo/current/python/lib
HOME=/var/lib/flaggo
PATH=/opt/flaggo/current/node/bin:/usr/bin:/bin
PYTHONDONTWRITEBYTECODE=1
MPLCONFIGDIR=/var/lib/flaggo/copilot-home/matplotlib
XDG_CACHE_HOME=/var/lib/flaggo/copilot-home/cache
OTEL_BSP_SCHEDULE_DELAY=100
OTEL_METRIC_EXPORT_INTERVAL=500
